# Copy this file to .env.local and fill these values from your Supabase project's
# Dashboard > Project Settings > API. Use the Project URL and publishable key
# (or the legacy anon key below). Never use a service_role/secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Example URL format: https://<your-project-ref>.supabase.co
# Copy your actual sb_publishable_... value from your project; do not use an example value.
# Legacy projects may use the anon key instead. Keep the publishable key empty
# when using this fallback; do not paste both values unless intentionally testing.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Set this to the application origin used for auth email and OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_FEASTYMAP_URL=
